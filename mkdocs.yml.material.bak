site_name: "Phys"

theme:
  name: material
  language: ja

  icon:
    logo: material/atom
    #logo: assets/logo.png   # 任意。なければ消してください。

  features:
    - navigation.tabs
    - navigation.sections
    - navigation.top
    - navigation.footer
    - content.code.copy       # コードのコピーボタン
    - content.code.annotate
    - content.tabs.link       # タブのリンク
    - toc.integrate           # コンテンツ内にTOC統合
    - header.autohide
    - search.suggest          # サジェスト付き検索
    - search.highlight

  palette:
    - scheme: default
      #primary: blue grey
      #primary: indigo
      #primary: teal
      #primary: grey
      #primary: cyan
      primary: black
      accent: blue 
    - scheme: slate
      #primary: teal
      primary: black
      accent: light blue
      accent: orange
      # accent: cyan
      # accent: deep orange
      toggle:
        icon: material/weather-night
        name: ダークモード
  
  favicon: assets/favicon.png



markdown_extensions:
  - admonition
  - pymdownx.superfences
  - codehilite:
      guess_lang: false
      pygments_style: monokai
  - pymdownx.arithmatex:
      generic: true
  - pymdownx.highlight
  - pymdownx.details
  - pymdownx.snippets
  - footnotes

#### for MathJax. katex と共存できないことに注意
extra_javascript:
  - https://polyfill.io/v3/polyfill.min.js?features=es6
  - js/mathjax_config.js
  - https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js


##### for KateX
# extra_javascript:
#   - https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.js
#   - https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/contrib/auto-render.min.js
#   - js/katex_auto.js

extra_css:
  #- https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css
  - extra.css

nav:
  - Home: index.md
  - 非線形拡散: 01_non-lin-diff-analyticals.md
  - em2d.f  : 02_em2d.md
  - init.f : 03_init.md
  - biriv.f : 04_bitriv_f.md
  - F77_style : 05_F77_style.md
  - 変数 : 06_Variables.md

plugins:
  - search:
      lang: ja
      min_search_length: 2
